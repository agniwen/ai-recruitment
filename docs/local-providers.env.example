# 复制到仓库根目录 .env.local-providers，填写后执行 setup。
# 这个文件仅提供字段说明，不包含任何可用凭据。不要提交填写后的文件。

# 简历解析、对话、结构化提取。agent 默认复用 ALIBABA_API_KEY。
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=deepseek-v4-flash-0731
ALIBABA_FAST_MODEL=deepseek-v4-flash-0731
ALIBABA_STRUCTURED_MODEL=deepseek-v4-flash-0731
# OCR 必须使用支持按量计费的端点/Key；地域需一致。
QWEN_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_OCR_MODEL=qwen-vl-ocr-latest
QWEN_OCR_API_KEY=

# 语音面试：对话模型、ElevenLabs STT、MiniMax TTS。
# DASHSCOPE_API_KEY 留空时复用 ALIBABA_API_KEY。
DASHSCOPE_API_KEY=
DASHSCOPE_LLM_MODEL=deepseek-v4-flash-0731
ELEVEN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_TTS_BASE_URL=https://api.minimax.chat

# 面试报告使用 AI Gateway。
AI_GATEWAY_API_KEY=
INTERVIEW_EVALUATION_MODEL=google/gemini-2.5-flash

# 可选：真实飞书或 Google 登录，需要在对应平台允许 localhost 回调。
# 留空或不配置时使用数据库中已有的邮箱密码账号登录。
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_APP_ID2=
# FEISHU_APP_SECRET2=
