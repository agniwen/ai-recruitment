# AI Recruitment 自托管首次部署模板，文档 v1.6。
# 放置位置：应用目录 /opt/ai-recruitment/.env；Web、Worker、Agent 共用。
# 所有 __FILL_...__ 必须替换。仅用于新环境；升级时逐项合并，不覆盖现有 .env。
# 默认启用：AI/真人面试、AI 录像、真人媒体采样、语义索引。
# 默认关闭：历史导入、Telegram 提醒、邮箱采集；邮件/Sheets 配置按需补充。
# 账号密钥含 $ 或 # 时使用 Compose 支持的单引号字面值；URL 中密码需 URL 编码。
# 本文件只由 Compose 读取，不要 source 到 Shell，不放进 Web/Backend 源码子目录。

# 01 必填：同一环境的数据库、业务队列；使用容器可达的主机名，不填 localhost。
TZ=Asia/Shanghai
DATABASE_URL=__FILL_DATABASE_URL__
REDIS_URL=__FILL_REDIS_URL__
# 新环境独立前缀；已有环境保留原前缀或原来的自动计算方式，避免遗留任务无人消费。
RESUME_PARSE_QUEUE_PREFIX=arc-production
POSTGRES_POOL_MAX=10
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_IDLE_TIMEOUT_SECONDS=60
POSTGRES_MAX_LIFETIME_SECONDS=1200

# 02 必填：以下四个 Origin 在默认同源部署时填同一个 HTTPS 地址，无路径。
BETTER_AUTH_URL=__FILL_HTTPS_APP_ORIGIN__
NEXT_PUBLIC_BASE_URL=__FILL_HTTPS_APP_ORIGIN__
NEXT_PUBLIC_BETTER_AUTH_URL=__FILL_HTTPS_APP_ORIGIN__
INTERVIEW_ENTRY_CREDENTIAL_ORIGIN=__FILL_HTTPS_APP_ORIGIN__
BETTER_AUTH_SECRET=__FILL_RANDOM_AUTH_SECRET__
# 必须提供真实 Google 和两套飞书凭据，即使当前只显示一个登录入口。
GOOGLE_CLIENT_ID=__FILL_GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__FILL_GOOGLE_CLIENT_SECRET__
FEISHU_APP_ID=__FILL_FEISHU_APP_ID__
FEISHU_APP_SECRET=__FILL_FEISHU_APP_SECRET__
FEISHU_APP_ID2=__FILL_FEISHU_APP_ID2__
FEISHU_APP_SECRET2=__FILL_FEISHU_APP_SECRET2__

# 03 Web 构建期与运行期一致；修改这些开关后重建 Web 镜像。
# 配套覆盖文件补充了录像、个性化题目两个构建参数。
NEXT_PUBLIC_AGENT_NAME=giaogiao
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=true
NEXT_PUBLIC_ENABLE_INTERVIEW_RECORDING=true
NEXT_PUBLIC_ENABLE_CANDIDATE_SPECIFIC_INTERVIEW_QUESTIONS=true

# 04 必填：业务 LLM / OCR；示例模型取代码默认值，须核对账号权限和区域。
ALIBABA_API_KEY=__FILL_DASHSCOPE_BUSINESS_KEY__
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=deepseek-v4-flash-0731
ALIBABA_FAST_MODEL=deepseek-v4-flash-0731
ALIBABA_STRUCTURED_MODEL=deepseek-v4-flash-0731
# 现存启动校验要求非空；实际报告选模由 ALIBABA_STRUCTURED_MODEL / MASTRA_* 决定。
INTERVIEW_EVALUATION_MODEL=deepseek-v4-flash-0731
MASTRA_POSTGRES_SCHEMA=mastra
QWEN_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_OCR_MODEL=qwen-vl-ocr-latest
# 可选，未设置时 OCR 回退 ALIBABA_API_KEY；主 Key 无 OCR 权限时单独填写。
# QWEN_OCR_API_KEY=
RESUME_PARSE_PROVIDER=ocr-llm

# 05 必填：简历/附件私有存储；MinIO 的 region/path style 需与实际实例一致。
S3_ENDPOINT=__FILL_S3_ENDPOINT__
S3_BUCKET_NAME=__FILL_PRIVATE_FILES_BUCKET__
S3_ACCESS_KEY_ID=__FILL_S3_ACCESS_KEY__
S3_SECRET_ACCESS_KEY=__FILL_S3_SECRET_KEY__
S3_REGION=us-east-1
S3_KEY_PREFIX=uploads
S3_FORCE_PATH_STYLE=true

# 06 必填（默认启用录像和真人采样）：S3 兼容私有存储，可使用 MinIO。
# 本组变量名称不限定供应商；可与文件存储同桶，权限与前缀按交付单填写。
RECORDING_R2_ENDPOINT=__FILL_RECORDING_ENDPOINT__
RECORDING_R2_BUCKET_NAME=__FILL_PRIVATE_RECORDING_BUCKET__
RECORDING_R2_ACCESS_KEY_ID=__FILL_RECORDING_ACCESS_KEY__
RECORDING_R2_SECRET_ACCESS_KEY=__FILL_RECORDING_SECRET_KEY__
RECORDING_R2_REGION=us-east-1
RECORDING_R2_KEY_PREFIX=recordings
RECORDING_R2_FORCE_PATH_STYLE=true
HUMAN_INTERVIEW_MEDIA_ENABLED=true
# 不设置 INTERVIEW_MEDIA_LOCAL_DIR；真人样本前缀不配置自动到期。

# 07 必填：LiveKit 与 Python Agent；保持与 LiveKit Server / Egress 配置一致。
LIVEKIT_URL=__FILL_LIVEKIT_WSS_URL__
LIVEKIT_API_KEY=__FILL_LIVEKIT_API_KEY__
LIVEKIT_API_SECRET=__FILL_LIVEKIT_API_SECRET__
AGENT_NAME=giaogiao
INTERVIEW_SELF_HOSTED=1
CALLBACK_BASE_URL=__FILL_HTTPS_APP_ORIGIN__
AGENT_CALLBACK_SECRET=__FILL_RANDOM_AGENT_CALLBACK_SECRET__
DASHSCOPE_API_KEY=__FILL_DASHSCOPE_AGENT_KEY__
DASHSCOPE_LLM_MODEL=deepseek-v4-flash-0731
ELEVEN_API_KEY=__FILL_ELEVENLABS_STT_KEY__
MINIMAX_API_KEY=__FILL_MINIMAX_TTS_KEY__
MINIMAX_TTS_BASE_URL=https://api.minimax.chat

# 08 语义索引（默认开启）；若关闭，改为 false 并去掉 QDRANT_* 占位行。
# 智能岗位推荐仍可能使用 Rerank 和业务 LLM。
RESUME_SEMANTIC_INDEX_ENABLED=true
QDRANT_URL=__FILL_PRIVATE_QDRANT_URL__
QDRANT_API_KEY=__FILL_QDRANT_API_KEY__
QDRANT_RESUME_COLLECTION=resume_semantic_v1
RESUME_EMBEDDING_MODEL=text-embedding-v4
RESUME_EMBEDDING_DIMENSIONS=1024
RESUME_EMBEDDING_VERSION=dashscope-text-embedding-v4-1024-v1
RESUME_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Embedding / Rerank 省略独立 Key 时沿用业务 Key，须同时具备对应模型权限。
# RESUME_EMBEDDING_API_KEY=
# RESUME_RERANK_API_KEY=
RESUME_RERANK_MODEL=qwen3-rerank
RESUME_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# 09 Worker：以下为新环境起步值，按资源和 Provider 限额验收后调整。
WORKER_DIAGNOSTICS_SECRET=__FILL_RANDOM_WORKER_DIAGNOSTICS_SECRET__
RESUME_PARSE_WORKER_CONCURRENCY=9
RESUME_PARSE_OCR_PAGE_CONCURRENCY=4
RESUME_REVIEW_GENERATION_WORKER_CONCURRENCY=50
RESUME_SEMANTIC_INDEX_WORKER_CONCURRENCY=2
RESUME_PARSE_QUEUE_BACKOFF_MS=30000
RESUME_PARSE_LOG_STEPS=false
RESUME_PARSE_DISABLE_CACHE=false
ENABLE_LEGACY_PARSE=false
INTERVIEW_TELEMETRY_RETENTION_DAYS=90

# 10 按需集成；启用时补齐凭据并完成外部回调登记和业务验收。
HUMAN_INTERVIEW_REMINDERS_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET_TOKEN=
MAIL_INGEST_ENABLED=false
# MAIL_INGEST_SECRET_KEY=  # API 与 Worker 必须相同，已有环境不得更换旧加密密钥。
# RESEND_API_KEY=
# RESEND_FROM=noreply@example.com  # 裸邮箱，发件域需验证。
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_SHEET_NAME=汇总表
# FEISHU_ENCRYPT_KEY=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY2=
# FEISHU_VERIFICATION_TOKEN2=
# FEISHU_EVALUATION_FOLDER_TOKEN=
# FEISHU_JIGUANG_HR_EVALUATION_FOLDER_TOKEN=
